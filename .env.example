# --- Modelo (obligatorio) ---
OPENROUTER_API_KEY=sk-or-...

# --- Telegram (obligatorio) ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=mi_bot_de_finanzas
TELEGRAM_WEBHOOK_SECRET_TOKEN=una-cadena-aleatoria-larga

# --- Acceso (obligatorio en producción) ---
# El bot solo responde a usuarios que hayan enviado /start <clave>
ACCESS_CODE=mi-clave-secreta

# --- Transcripción de notas de voz (obligatorio para modo voz) ---
ASSEMBLYAI_API_KEY=...
ASSEMBLYAI_LANGUAGE_CODE=es
# ASSEMBLYAI_SPEECH_MODEL=best
# ASSEMBLYAI_TIMEOUT_MS=120000

# --- Base de datos (opcional) ---
# Por defecto: file:data/finanzas.db (persistido por el volumen ./data)
# Para Turso: libsql://<db>-<org>.turso.io + token
# DATABASE_URL=file:data/finanzas.db
# DATABASE_AUTH_TOKEN=

# --- Dominio público para Caddy (obligatorio en el VPS) ---
# Ej: <ip>.sslip.io  o  <subdominio>.duckdns.org
DOMAIN=finanzas.mi-dominio.com
